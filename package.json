{
  "name": "quickdraw",
  "version": "2.0.0",
  "private": true,
  "description": "How Long Does it Take to (Quick) Draw a Dog? An exploration of drawing times in Google's Quickdraw dataset.",
  "type": "module",
  "scripts": {
    "dev": "esbuild src/main.js --bundle --format=esm --outfile=build/app.js --external:/fonts/* --servedir=. --watch",
    "build": "esbuild src/main.js --bundle --format=esm --minify --target=es2020,chrome100,firefox100,safari15 --external:/fonts/* --outfile=build/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlandham/quickdraw.git"
  },
  "author": "Jim Vallandingham <vlandham@gmail.com> (https://vallandingham.me/)",
  "license": "MIT",
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
